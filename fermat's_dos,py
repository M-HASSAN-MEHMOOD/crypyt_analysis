import math
def fermat_factor(n):
    if n % 2 == 0:
        return n // 2, 2
        
        
    a = math.ceil(math.sqrt(n))
    while True:
        b2 = a * a - n
        b = math.isqrt(b2)
        if b * b == b2:
            return a - b, a + b
        a += 1
        
n = 8927
print(fermat_factor(n))
